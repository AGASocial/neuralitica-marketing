# Copy to .env and fill in values.
# See README § Environment variables for details.

# Next.js server (no NEXT_PUBLIC_ prefix for Supabase keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase MCP / CLI
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Auth dev fallback until US-14.5
AUTH_DEV_FALLBACK=true
