# Copy to .env and fill in values.

# Next.js server (no NEXT_PUBLIC_ prefix for Supabase keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alias accepted by lib/supabase/server.ts if SERVICE_ROLE_KEY is unset
SUPABASE_SECRET_KEY=

# Supabase MCP / CLI
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Local-only identity fallback. Do NOT set on Vercel production (startup throw
# if AUTH_DEV_FALLBACK is any non-empty string when NODE_ENV=production).
# Default path is session-backed. Uncomment to skip Auth lookup locally:
# AUTH_DEV_FALLBACK=true

# HMAC secret for neuramark_auth_attempts ip/email hashing (falls back to service role key)
AUTH_RATE_LIMIT_SECRET=

# Server-only public origin of this app (no NEXT_PUBLIC_ prefix).
# Must be on the Supabase Auth redirect allowlist (Authentication → URL configuration):
#   SITE_URL + /auth/callback           (signup confirmation, Path A)
#   SITE_URL + /auth/callback/recovery  (password recovery — US-14.4; not Path A)
SITE_URL=http://localhost:3000

# Ops (Supabase dashboard — not a neuramark_ migration):
# Authentication → Emails / Mailer: OTP / recovery token expiry ≤ 1 hour
# (e.g. ≤ 3600 seconds). Recovery tokens are single-use. Changing the password
# invalidates outstanding recovery tokens (provider behavior).
